# Copia este archivo como `.env` y completa los IDs de OAuth de Google.
# No subas `.env` al repositorio.
#
# Web: usa un cliente OAuth de tipo "Web application".
# Android/iOS: usa los clientes nativos correspondientes o, en Expo Go,
# EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID.
# Si EXPO_PUBLIC_API_URL se deja vacío, se usa:
# - web/iOS: http://localhost:3000
# - Android: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
