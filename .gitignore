# ===========================
# FindU - .gitignore unificado
# ===========================

# -------------------------
# Sistema operativo
# -------------------------
.DS_Store
Thumbs.db
*.swp
*~
.directory

# -------------------------
# IDEs / Editores
# -------------------------
.idea/
.vscode/
*.iml
*.iws
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# -------------------------
# Node.js
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
*.tsbuildinfo
.cache/
.parcel-cache/
dist/
dist-ssr/
*.local

# -------------------------
# Variables de entorno
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# React Native / Expo
# -------------------------
.expo/
__generated__/
android/
ios/
build/
.gradle/
local.properties
*.apk
*.aab
*.jks
*.keystore
*.pem
*.key
*.p12
*.pfx
google-services.json

# -------------------------
# Backend - Archivos subidos
# -------------------------
findu-backend/uploads/*
!findu-backend/uploads/.gitkeep

# -------------------------
# Testing / Coverage
# -------------------------
coverage/
.nyc_output/
*.lcov

# -------------------------
# Logs
# -------------------------
logs/
*.log
*.hprof

# -------------------------
# Builds
# -------------------------
build/
**/build/
.out/
