# Copia este archivo como `.env` y completa los valores de tu entorno local.
# No subas `.env`, contraseñas, secretos JWT ni credenciales reales.

# PostgreSQL
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=5432
DB_TIMEZONE=America/La_Paz

# Servidor HTTP
PORT=3000

# Google OAuth: uno o más client IDs separados por coma.
GOOGLE_CLIENT_IDS=
DOMINIO_INSTITUCIONAL=

# Usa un secreto largo, aleatorio y exclusivo para cada entorno.
JWT_SECRET=
JWT_EXPIRACION_HORAS=24
