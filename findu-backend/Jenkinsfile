pipeline {
    agent any

    stages {
        stage('Install Dependencies') {
            steps {
                dir('findu-backend') {
                    sh 'npm install'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('findu-backend') {
                    sh 'npm test'
                }
            }
        }
    }

    post {
        success {
            echo "Tests ejecutados correctamente."
        }
        failure {
            echo "Los tests fallaron."
        }
    }
}
